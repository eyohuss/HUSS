# Flask Configuration
FLASK_ENV=production
FLASK_APP=app.py
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DATABASE_URL=sqlite:///vaspera.db

# Flask Settings
FLASK_DEBUG=False

# Gunicorn Configuration (for Render)
WORKERS=4
WORKER_CLASS=sync
BIND=0.0.0.0:5000

# Application Port
PORT=5000
